  "components": {
    "schemas": {
      "AcceptedCommentaryItem": {
        "properties": {
          "flag_id": {
            "type": "string",
            "title": "Flag Id"
          },
          "reporting_line": {
            "type": "string",
            "title": "Reporting Line"
          },
          "order": {
            "type": "integer",
            "title": "Order"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "is_edited": {
            "type": "boolean",
            "title": "Is Edited"
          },
          "provenance": {
            "$ref": "#/components/schemas/DraftProvenance"
          }
        },
        "type": "object",
        "required": [
          "flag_id",
          "reporting_line",
          "order",
          "text",
          "is_edited",
          "provenance"
        ],
        "title": "AcceptedCommentaryItem"
      },
      "AnswerRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "accepted_hypothesis": {
            "type": "boolean",
            "title": "Accepted Hypothesis",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AnswerRequest"
      },
      "ControllerInput": {
        "properties": {
          "input_id": {
            "type": "string",
            "title": "Input Id"
          },
          "flag_id": {
            "type": "string",
            "title": "Flag Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "accepted_hypothesis": {
            "type": "boolean",
            "title": "Accepted Hypothesis",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "input_id",
          "flag_id",
          "text"
        ],
        "title": "ControllerInput"
      },
      "Draft": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "draft_id": {
            "type": "string",
            "title": "Draft Id"
          },
          "flag_id": {
            "type": "string",
            "title": "Flag Id"
          },
          "commentary": {
            "type": "string",
            "title": "Commentary"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/GLEvidenceRow"
            },
            "type": "array",
            "title": "Evidence"
          },
          "rendered_figures": {
            "items": {
              "$ref": "#/components/schemas/RenderedFigure"
            },
            "type": "array",
            "title": "Rendered Figures"
          },
          "controller_input": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ControllerInput"
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "$ref": "#/components/schemas/DraftProvenance"
          },
          "llm_log_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Llm Log Refs"
          },
          "is_proposal": {
            "type": "boolean",
            "const": true,
            "title": "Is Proposal",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "draft_id",
          "flag_id",
          "commentary",
          "evidence",
          "rendered_figures",
          "provenance",
          "llm_log_refs"
        ],
        "title": "Draft"
      },
      "DraftProvenance": {
        "properties": {
          "flag_id": {
            "type": "string",
            "title": "Flag Id"
          },
          "evidence_row_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Row Ids"
          },
          "controller_input_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Controller Input Id"
          }
        },
        "type": "object",
        "required": [
          "flag_id",
          "evidence_row_ids"
        ],
        "title": "DraftProvenance"
      },
      "EditRequest": {
        "properties": {
          "edited_text": {
            "type": "string",
            "title": "Edited Text"
          }
        },
        "type": "object",
        "required": [
          "edited_text"
        ],
        "title": "EditRequest"
      },
      "FigureSource": {
        "type": "string",
        "enum": [
          "block1",
          "gl",
          "aggregate"
        ],
        "title": "FigureSource"
      },
      "FlaggedVariance": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "flag_id": {
            "type": "string",
            "title": "Flag Id"
          },
          "reporting_line": {
            "type": "string",
            "title": "Reporting Line"
          },
          "line_type": {
            "$ref": "#/components/schemas/LineType"
          },
          "time_cut": {
            "$ref": "#/components/schemas/TimeCut"
          },
          "scenario_pair": {
            "$ref": "#/components/schemas/ScenarioPair"
          },
          "current_value": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Current Value"
          },
          "comparator_value": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Comparator Value"
          },
          "abs_variance": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abs Variance"
          },
          "pct_variance": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pct Variance"
          },
          "pp_variance": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pp Variance"
          },
          "direction": {
            "type": "string",
            "enum": [
              "favorable",
              "unfavorable"
            ],
            "title": "Direction"
          },
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "abs_threshold": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Abs Threshold"
          },
          "pct_threshold": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Pct Threshold"
          },
          "pp_threshold": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Pp Threshold"
          }
        },
        "type": "object",
        "required": [
          "flag_id",
          "reporting_line",
          "line_type",
          "time_cut",
          "scenario_pair",
          "current_value",
          "comparator_value",
          "direction",
          "rule_id",
          "abs_threshold",
          "pct_threshold",
          "pp_threshold"
        ],
        "title": "FlaggedVariance",
        "description": "Versioned PUBLIC CONTRACT consumed by Block 3 (the AI layer).\n\nDecimal fields serialize as strings in JSON mode (Pydantic v2 default) to\npreserve exact precision across the block boundary. Do not change this shape\nwithout bumping ``schema_version`` and the committed JSON Schema."
      },
      "FlaggedVarianceView": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "flag_id": {
            "type": "string",
            "title": "Flag Id"
          },
          "reporting_line": {
            "type": "string",
            "title": "Reporting Line"
          },
          "line_type": {
            "$ref": "#/components/schemas/LineType"
          },
          "time_cut": {
            "$ref": "#/components/schemas/TimeCut"
          },
          "scenario_pair": {
            "$ref": "#/components/schemas/ScenarioPair"
          },
          "current_value": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Current Value"
          },
          "comparator_value": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Comparator Value"
          },
          "abs_variance": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abs Variance"
          },
          "pct_variance": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pct Variance"
          },
          "pp_variance": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pp Variance"
          },
          "direction": {
            "type": "string",
            "enum": [
              "favorable",
              "unfavorable"
            ],
            "title": "Direction"
          },
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "abs_threshold": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Abs Threshold"
          },
          "pct_threshold": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Pct Threshold"
          },
